{
  "name": "cartyx-app",
  "version": "0.2.0",
  "description": "Cartyx — D&D Campaign Management Platform",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "node -e \"const fs=require('fs'); if (fs.existsSync('.git')) require('child_process').execFileSync(process.platform === 'win32' ? 'npx.cmd' : 'npx', ['lefthook', 'install'], { stdio: 'inherit' });\"",
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "vite dev",
    "build": "NODE_ENV=production vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ci": "vitest run --project unit --coverage --reporter=verbose",
    "e2e": "playwright test",
    "e2e:container": "bash deploy/local/e2e-container.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:full": "node scripts/build-storybook-with-iframe.mjs",
    "realtime:dev": "npm --prefix realtime run dev",
    "check:deps-age": "node scripts/check-package-age.mjs",
    "db:verify": "tsx scripts/mongo-admin.ts verify",
    "db:sync": "tsx scripts/mongo-admin.ts sync",
    "dev:clear": "node scripts/run-python.cjs dev_clear.py",
    "dev:seed": "node scripts/run-python.cjs dev_seed.py && node scripts/gen_seed_avatars.mjs && node scripts/gen_seed_lore_images.mjs && node scripts/gen_seed_org_images.mjs && node scripts/gen_seed_quest_images.mjs",
    "dev:repair-images": "node scripts/run-python.cjs repair_seed_images.py && node scripts/gen_seed_avatars.mjs",
    "dev:gen-avatars": "node scripts/gen_seed_avatars.mjs",
    "fixture": "tsx scripts/dev-fixtures/cli.ts",
    "srd:lint": "tsx scripts/srd/lint.ts",
    "srd:extract": "tsx scripts/srd/extract-rules.ts",
    "srd:generate": "tsx scripts/srd/generate-srd-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/pro-solid-svg-icons": "file:./vendor/pro-solid-svg-icons",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@sentry/browser": "^10.66.0",
    "@sentry/node": "^10.66.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "dayjs": "^1.11.20",
    "jose": "^6.2.2",
    "konva": "^10.2.5",
    "lucide-react": "^1.25.0",
    "mongoose": "^9.7.4",
    "nitro": "^3.0.260522-beta",
    "partysocket": "^1.3.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.2",
    "react-konva": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.3.6",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "h3-v2": "npm:h3@2.0.1-rc.19",
    "js-yaml": "4.3.1",
    "postcss": "8.5.26",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-onboarding": "^10.5.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "~5.1.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "cspell": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^10.5.2",
    "globals": "^17.5.0",
    "happy-dom": "^20.10.6",
    "lefthook": "^2.1.10",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "storybook": "10.5.2",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
